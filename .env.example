# Copy to `.env.local` for local dev. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Resend (contact welcome + optional admin mail)
RESEND_API_KEY=
RESEND_FROM=HapVi Together <info@hapvi.org>

# Contact form → Google Apps Script web app URL
GOOGLE_SHEETS_WEBHOOK_URL=

# Footer waitlist → Apps Script URL for Waitlist sheet tab
WAITLIST_GOOGLE_SHEETS_WEBHOOK_URL=

# Phase 9: community_resources CMS (Apps Script GET → JSON). See docs/PHASE9.md
# RESOURCES_CMS_URL=

# Optional admin notification (lib/admin-mail.ts)
# WAITLIST_NOTIFY_EMAIL=info@hapvi.org

# Optional legacy webhook (app/api/waitlist) — prefer Google Sheet URL above
# WAITLIST_WEBHOOK_URL=

# Optional SMTP fallback (lib/admin-mail.ts) if Resend is not used
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=
